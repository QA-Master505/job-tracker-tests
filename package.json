{
  "name": "job-tracker-tests",
  "version": "1.0.0",
  "description": "Playwright TypeScript test automation framework for Job Application Tracker",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:api": "playwright test tests/api/",
    "test:ui-only": "playwright test tests/ui/",
    "test:bdd": "cucumber-js --config cucumber.config.js",
    "test:bdd:headed": "HEADLESS=false cucumber-js --config cucumber.config.js",
    "codegen": "playwright codegen http://localhost:5173",
    "cli:open": "playwright-cli open http://localhost:5173",
    "cli:show": "playwright-cli show",
    "cli:snapshot": "playwright-cli snapshot",
    "cli:screenshot": "playwright-cli screenshot"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@cucumber/pretty-formatter": "^3.3.1",
    "@playwright/cli": "^0.1.13",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "allure-commandline": "^2.30.0",
    "allure-cucumberjs": "^3.9.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
